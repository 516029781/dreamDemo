            "commandWindows": "\"C:/Users/tt/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe\" \"C:/软件/鼠鼠/.codex/hooks/static_map_quality_hook.py\" --event UserPromptSubmit",
